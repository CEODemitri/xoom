{
  "project_name": "Xoom",
  "version": "1.0.0",
  "prompt_type": "strict",
  "project_overview": {
    "brand": "Xoom",
    "tagline": "Move. Reset. Nourish.",
    "description": "A three-space wellness app for workouts, mental resets, and simple nourishment. Extreme minimalism: one primary action per screen, generous whitespace, warm neutral surfaces, and a single clay accent. The app must feel like a quiet tool — calm, fast, and honest. No noise, no gamified clutter, no fitness-coach energy. A user opens the app, picks from a workout pool or just sets a timer, finishes, and the session logs itself. Two quiet companion spaces — Mind and Eat — sit beside the workout flow.",
    "core_theme": "Nothing extra. Every screen does one thing. Every log happens automatically. The app is a still room, not a stadium.",
    "requirements": "A complete, self-contained app build. Architecture and code quality are primary. No backend, auth providers, cloud sync, analytics, or CMS. All persistence is local (localStorage or IndexedDB). No social features, leaderboards, or notifications unless explicitly specified."
  },
  "tech_stack": {
    "mandatory": [
      "React 18+ with TypeScript (strict mode)",
      "Vite (build tool)",
      "Tailwind CSS (layout, spacing, typography, responsive behavior)",
      "Framer Motion (all meaningful motion, transitions, timer and breathing animations)",
      "React Router (routes for each space and screen)",
      "Zustand (local app state)",
      "date-fns (month calendar, date formatting)"
    ],
    "allowed": [
      "Headless accessibility primitives (e.g., Radix Primitives) only where they do not impose visual design",
      "idb-keyval or localStorage wrapper for persistence",
      "clsx / tailwind-merge for class composition"
    ],
    "forbidden": [
      "Angular, Vue, Svelte, or any non-React framework",
      "jQuery",
      "Bootstrap or any component CSS framework",
      "CSS gradients (linear-gradient, radial-gradient, conic-gradient) anywhere",
      "External SVG files (EXCEPTION: the brand logo mark and explicitly listed UI icons, inline only)",
      "Any third-party icon library (Font Awesome, Lucide, Material Icons, Heroicons, Phosphor, etc.) — inline SVG only",
      "Emojis in code, copy, or UI",
      "Stock photos from any source",
      "CSS keyframe animations as the primary motion mechanism (Framer Motion must drive all meaningful motion)",
      "Confetti, streak flames, badges, trophies, or any gamification library",
      "Chart libraries (no recharts, chart.js, d3) — stats are shown as plain numbers and a simple calendar",
      "Backend, auth providers, or cloud sync"
    ]
  },
  "color_system": {
    "tokens": [
      { "name": "color-paper", "hex": "#F4F0E8", "usage": "Dominant app background (warm paper)" },
      { "name": "color-linen", "hex": "#ECE6DA", "usage": "Cards, sheets, session tray, input backgrounds" },
      { "name": "color-sand", "hex": "#DFD7C8", "usage": "Borders on cards, inputs, dividers" },
      { "name": "color-ink", "hex": "#1B1916", "usage": "Headings, primary text, primary button background" },
      { "name": "color-graphite", "hex": "#3B3732", "usage": "Body text" },
      { "name": "color-smoke", "hex": "#78716A", "usage": "Secondary text, captions, helper text, inactive tabs" },
      { "name": "color-clay", "hex": "#B85A3C", "usage": "Single accent: active tab, running timer digits, selected chips, progress dots, focus ring" },
      { "name": "color-clay-deep", "hex": "#98442A", "usage": "Pressed state for clay elements only" },
      { "name": "color-white", "hex": "#FFFFFF", "usage": "Text only, and only on ink or clay backgrounds" }
    ],
    "rules": [
      "Background is always color-paper unless an element is a card or sheet (color-linen).",
      "Body text is color-graphite on paper. Headings are color-ink.",
      "Primary buttons: color-ink background, color-white text.",
      "Secondary buttons: transparent background, 1px color-ink border, color-ink text.",
      "The clay accent is the ONLY accent color. It appears only on: active bottom-tab, running timer digits, selected filter chips, selected workout card border, mood/effort dot selection, focus-visible ring, and streak count on the You screen.",
      "The three spaces (Train, Mind, Eat) are NOT color-coded. Differentiation is by layout, copy, and inline icons only.",
      "No gradients anywhere. Flat fills only.",
      "No color transitions via CSS. Any color change is handled by Framer Motion or is an instant state swap.",
      "Never place clay text on ink or white-on-clay for body copy. Clay is for small marks and digits, not paragraphs.",
      "Cards use color-linen background, 1px solid color-sand border, no shadow. Depth comes from the border, not shadow.",
      "Shadows are forbidden everywhere except a single optional soft shadow on the bottom sheet / modal (0 8px 24px rgba(27,25,22,0.08))."
    ]
  },
