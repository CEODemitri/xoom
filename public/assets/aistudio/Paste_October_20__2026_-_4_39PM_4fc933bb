  "design_principles": [
    "One primary action per screen. If a screen has two, one is visually dominant.",
    "Whitespace is the design. Never fill space to avoid emptiness.",
    "No cards inside cards. No borders on borders.",
    "The timer is the only element allowed to be visually loud. Everything else is quiet.",
    "Numbers (durations, stats, timers, day numbers) use DM Mono. Prose and labels use DM Sans. Titles use Fraunces.",
    "The clay accent earns its use. If clay appears more than three times on one screen, remove one.",
    "No decorative icons. Every inline SVG icon carries information.",
    "Motion is soft, brief, and functional. If it doesn't clarify a state change, it does not animate.",
    "No empty-state illustrations. Empty states are a single caption line or nothing.",
    "The three spaces never compete for attention. Each screen starts fresh."
  ],
  "motion_system": {
    "library": "Framer Motion only",
    "principles": [
      "All meaningful transitions use Framer Motion. CSS transitions are allowed only for :hover color swaps on desktop and focus ring appearance.",
      "Animate transform and opacity only. Never animate layout properties (width, height, top, left).",
      "Default easing: easeOut. Default duration: 0.22s for route changes and small state changes.",
