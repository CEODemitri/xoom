  "logo": {
    "type": "Inline SVG wordmark + mark",
    "design": "A single horizontal baseline stroke (color-ink) with one short parallel dash offset above and to the right — a mark caught mid-motion, held still. Beside it, the wordmark 'Xoom' set in Fraunces 600, letter-spacing -0.02em. The mark reads as speed reduced to its minimum: two lines, one dot of intention.",
    "requirements": [
      "Inline SVG only — no external .svg files",
      "Accessible: role=\"img\" with aria-label=\"Xoom logo\"",
      "On light surfaces: baseline, dash, and wordmark are color-ink",
      "Logo is tappable and always routes to the Train screen",
      "Minimum clear space: 16px on all sides",
      "The mark must be legible at 20px height"
    ],
    "hover_animation": {
      "library": "Framer Motion",
      "sequence": [
        { "action": "Short dash translates right 3px and slightly up (x: 3, y: -1)", "duration": 0.16, "ease": "easeOut" },
        { "action": "Dash springs back to rest position", "transition": { "type": "spring", "stiffness": 260, "damping": 16 } }
      ]
    }
  },
